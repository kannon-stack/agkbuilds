# Copy to .env and fill in. Never commit .env.

# Dashboard login. Required: `docker compose` refuses to start until this is set.
# Use a long, unique password; do not reuse the upstream default.
INITIAL_PASSWORD=

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
API_KEY_SECRET=
MACHINE_ID_SALT=

# Public origin of the dashboard. Use your tunnel hostname once you have one,
# e.g. https://9router.example.com. Leave as-is for local-only use.
BASE_URL=http://localhost:20128

# Only needed for `--profile tunnel` (named tunnel token from Zero Trust).
TUNNEL_TOKEN=

# Host port the dashboard is published on (loopback only). Change if 20128 is taken.
# HOST_PORT=20128

# Optional overrides
# NINE_ROUTER_VERSION=0.5.112
# AUTH_COOKIE_SECURE=true
