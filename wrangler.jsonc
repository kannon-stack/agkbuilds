{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agkbuilds",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "agkbuilds.net", "custom_domain": true },
    { "pattern": "www.agkbuilds.net", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "previews": {},
  "observability": {
    "enabled": true
  }
}
